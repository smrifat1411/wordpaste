{
  "name": "wordpaste",
  "version": "0.12.0",
  "description": "Clean clipboard HTML from Microsoft Word, LibreOffice Writer, Google Docs, Outlook and Excel on paste, and keep equations editable as LaTeX (OMML and MathML). Zero dependencies. Tiptap, ProseMirror, Lexical or plain contenteditable.",
  "keywords": [
    "word",
    "paste",
    "paste-from-word",
    "word-paste",
    "clipboard",
    "clean-html",
    "mso",
    "contenteditable",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "tiptap",
    "prosemirror",
    "lexical",
    "quill",
    "omml",
    "mathml",
    "latex",
    "katex",
    "equation",
    "math",
    "docx",
    "office",
    "google-docs",
    "libreoffice"
  ],
  "license": "MIT",
  "author": "Rifat Hossain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smrifat1411/wordpaste.git"
  },
  "homepage": "https://github.com/smrifat1411/wordpaste#readme",
  "bugs": {
    "url": "https://github.com/smrifat1411/wordpaste/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "audit:docs": "node scripts/audit-docs.mjs",
    "prepublishOnly": "npm run build && npm test && npm run audit:docs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
