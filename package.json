{
  "name": "wordpaste",
  "version": "0.1.0",
  "description": "Clean Microsoft Word clipboard HTML and turn Word equations into editable LaTeX. Editor-agnostic, zero dependencies.",
  "keywords": [
    "word",
    "paste",
    "clipboard",
    "omml",
    "mathml",
    "latex",
    "docx",
    "wysiwyg",
    "tiptap",
    "prosemirror"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
